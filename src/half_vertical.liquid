<!-- Custom Field Reference for Linter: {{ selected_year }} -->



<div class="layout layout--col p--2 gap--xsmall">
  <!-- Top: Setting Info -->
  <div class="flex flex--col pb--1">
    <div class="flex--row flex--between flex--center-y">
      <span class="label label--small lg:label--base text--gray-30 1bit:text--black">TARGET YEAR: {{ selected_year }}</span>
      <span class="label label--small lg:label--base text--gray-30 1bit:text--black">Active: {{ active_year }}</span>
    </div>
    <div class="flex flex--col mt--1">
      <span class="value value--small lg:value--large value--tnums mb--1">{% if clock_face %}{{ clock_face }}{% else %}<span class="label label--small lg:label--base label--outline">--:--:--</span>{% endif %}</span>
      <span class="title title--small lg:title--large text--black">({% if display_time %}{{ display_time }}{% else %}<span class="label label--small lg:label--base label--outline">Unknown time</span>{% endif %} to midnight)</span>
    </div>
    <div class="divider mt--2"></div>
  </div>

  <div class="flex flex--col pt--1 pb--1">
    <span class="label label--small lg:label--base text--gray-30 1bit:text--black">REASON & CONTEXT</span>
    {% if reason %}
      <p class="description lg:description--large text--black" data-clamp="3">{{ reason }}</p>
    {% else %}
      <span class="label label--small lg:label--base text--gray-30 1bit:text--black"><span class="label label--small lg:label--base label--outline">Reason details unavailable</span></span>
    {% endif %}
  </div>

  <!-- Bottom: Danger Index Chart -->
  <div class="flex flex--col pt--1">
    <div class="divider mb--2"></div>
    <span class="label label--small lg:label--base text--gray-30 1bit:text--black mb--1">DANGER INDEX OVER TIME (1947 - {{ latest_year }})</span>
    <div class="p--1 bg--white border border--black rounded w--full">
      {% if data_unavailable %}
        <div class="flex flex--col flex--center-y flex--center-x py--4 text--center">
          <span class="label label--small lg:label--base text--gray-30 1bit:text--black">Chart Unavailable</span>
          <span class="description text--black mt--1">Insufficient historical data to render trends.</span>
        </div>
      {% else %}
        <!-- Standard View SVG -->
        <svg class="block w--full h--auto lg:hidden" viewbox="0 0 400 180" preserveAspectRatio="xMidYMid meet">
          <!-- Grid lines (Y-axis) -->
          <g>
            {% for g in grid_lines %}
              <line x1="{{ grid_x1 | default: 35 }}" y1="{{ g.y }}" x2="{{ grid_x2 | default: 375 }}" y2="{{ g.y }}" stroke="#000" stroke-dasharray="2,2" stroke-width="1" />
              <text x="{{ grid_label_x | default: 30 }}" y="{{ g.y }}" class="text--xxsmall" fill="#000" text-anchor="end" dominant-baseline="central">{{ g.label }}</text>
            {% endfor %}
          </g>

          <!-- X axis labels (Years) -->
          <g>
            {% for xl in x_labels %}
              <text x="{{ xl.x }}" y="{{ x_label_y | default: 174 }}" class="text--xxsmall" fill="#000" text-anchor="middle">{{ xl.label }}</text>
            {% endfor %}
          </g>

          <!-- SVG path representing Doomsday Clock trend line -->
          <g>
            <path d="{{ svg_path }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="miter" stroke-linecap="square" />

            <!-- Selected Year Highlight Dot -->
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="5" fill="#000" />
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="8" fill="none" stroke="#000" stroke-width="1.5" />
          </g>
        </svg>

        <!-- Model X View SVG -->
        <svg class="hidden lg:block w--full h--auto" viewbox="0 0 400 180" preserveAspectRatio="xMidYMid meet">
          <!-- Grid lines (Y-axis) -->
          <g>
            {% for g in grid_lines_lg %}
              <line x1="{{ grid_x1_lg | default: 15 }}" y1="{{ g.y }}" x2="{{ grid_x2_lg | default: 395 }}" y2="{{ g.y }}" stroke="#000" stroke-dasharray="2,2" stroke-width="1" />
              <text x="{{ grid_label_x_lg | default: 10 }}" y="{{ g.y }}" class="text--xxsmall" fill="#000" text-anchor="end" dominant-baseline="central">{{ g.label }}</text>
            {% endfor %}
          </g>

          <!-- X axis labels (Years) -->
          <g>
            {% for xl in x_labels_lg %}
              <text x="{{ xl.x }}" y="{{ x_label_y_lg | default: 176 }}" class="text--xxsmall" fill="#000" text-anchor="middle">{{ xl.label }}</text>
            {% endfor %}
          </g>

          <!-- SVG path representing Doomsday Clock trend line -->
          <g>
            <path d="{{ svg_path_lg }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="miter" stroke-linecap="square" />

            <!-- Selected Year Highlight Dot -->
            <circle cx="{{ dot_x_lg }}" cy="{{ dot_y_lg }}" r="5" fill="#000" />
            <circle cx="{{ dot_x_lg }}" cy="{{ dot_y_lg }}" r="8" fill="none" stroke="#000" stroke-width="1.5" />
          </g>
        </svg>
      {% endif %}
    </div>
    <div class="flex flex--row flex--between flex--center-y text--gray-30 1bit:text--black mt--1">
      <span class="label label--small 1bit:text--black">Peak Danger (Midnight)</span>
      <span class="label label--small 1bit:text--black">Safest (17 minutes)</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
  <span class="instance">Target: {{ selected_year }}</span>
</div>




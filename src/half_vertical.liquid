<!-- Custom Field Reference for Linter: {{ selected_year }} -->



<div class="layout layout--col p--1 gap--xsmall">
  <!-- Top: Setting Info -->
  <div class="flex flex--col pb--1 border--h border--h-black">
    <div class="flex--row flex--between flex--center-y">
      <span class="label label--small text--gray-30">TARGET YEAR: {{ selected_year }}</span>
      <span class="label label--small text--gray-30">Active: {{ active_year }}</span>
    </div>
    <div class="flex flex--col mt--1">
      <span class="value value--small value--tnums mb--1">{% if clock_face %}{{ clock_face }}{% else %}--:--:-- PM{% endif %}</span>
      <span class="title title--small text--black">({% if display_time %}{{ display_time }}{% else %}Unknown time{% endif %} to midnight)</span>
    </div>
  </div>

  <div class="flex flex--col pt--1 pb--1">
    <span class="label label--small text--gray-30">REASON & CONTEXT</span>
    {% if reason %}
      <p class="description text--black">{{ reason }}</p>
    {% else %}
      <span class="label label--small text--gray-30">Reason details unavailable</span>
    {% endif %}
  </div>

  <!-- Bottom: Danger Index Chart -->
  <div class="flex flex--col pt--1 border--h border--h-black">
    <span class="label label--small text--gray-30 mb--1">DANGER INDEX OVER TIME (1947 - {{ latest_year }})</span>
    <div class="p--1 bg--white border border--black rounded flex flex--center-x w--full h--40">
      {% if data_unavailable %}
        <div class="flex flex--col flex--center-y flex--center-x py--8 text--center">
          <span class="label label--small text--gray-30">Chart Unavailable</span>
          <span class="description text--black mt--1">Insufficient historical data to render trends.</span>
        </div>
      {% else %}
        <svg class="block h--full w--auto" viewBox="0 0 380 240">
          <!-- Grid lines (Y-axis) -->
          <g>
            {% for g in grid_lines %}
              <line x1="35" y1="{{ g.y }}" x2="380" y2="{{ g.y }}" stroke="currentColor" stroke-dasharray="2,2" stroke-width="1" />
              <text x="30" y="{{ g.y }}" fill="currentColor" font-size="12" font-family="sans-serif" text-anchor="end" dominant-baseline="central">{{ g.label }}</text>
            {% endfor %}
          </g>

          <!-- X axis labels (Years) -->
          <g>
            {% for xl in x_labels %}
              <text x="{{ xl.x }}" y="196" fill="currentColor" font-size="12" font-family="sans-serif" text-anchor="middle">{{ xl.label }}</text>
            {% endfor %}
          </g>

          <!-- SVG path representing Doomsday Clock trend line -->
          <g>
            <path d="{{ svg_path }}" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="miter" stroke-linecap="square" />

            <!-- Selected Year Highlight Dot -->
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="5" fill="currentColor" />
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="8" fill="none" stroke="currentColor" stroke-width="1.5" />
          </g>
        </svg>
      {% endif %}
    </div>
    <div class="flex flex--row flex--between flex--center-y text--gray-30 mt--1">
      <span class="label label--small">Peak Danger (Midnight)</span>
      <span class="label label--small">Safest (17 minutes)</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
  <span class="instance">Target: {{ selected_year }}</span>
</div>




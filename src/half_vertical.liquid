<!-- Custom Field Reference for Linter: {{ selected_year }} -->



<div class="layout layout--col p--2 gap--xsmall">
  <!-- Top: Setting Info -->
  <div class="flex flex--col pb--1">
    <div class="flex--row flex--between flex--center-y">
      <span class="label label--small text--gray-30">TARGET YEAR: {{ selected_year }}</span>
      <span class="label label--small text--gray-30">Active: {{ active_year }}</span>
    </div>
    <div class="flex flex--col mt--1">
      <span class="value value--small value--tnums mb--1">{% if clock_face %}{{ clock_face }}{% else %}<span class="label label--small label--outline">--:--:--</span>{% endif %}</span>
      <span class="title title--small text--black">({% if display_time %}{{ display_time }}{% else %}<span class="label label--small label--outline">Unknown time</span>{% endif %} to midnight)</span>
    </div>
    <div class="divider mt--2"></div>
  </div>

  <div class="flex flex--col pt--1 pb--1">
    <span class="label label--small text--gray-30">REASON & CONTEXT</span>
    {% if reason %}
      <p class="description text--black" data-clamp="3">{{ reason }}</p>
    {% else %}
      <span class="label label--small text--gray-30"><span class="label label--small label--outline">Reason details unavailable</span></span>
    {% endif %}
  </div>

  <!-- Bottom: Danger Index Chart -->
  <div class="flex flex--col pt--1">
    <div class="divider mb--2"></div>
    <span class="label label--small text--gray-30 mb--1">DANGER INDEX OVER TIME (1947 - {{ latest_year }})</span>
    <div class="p--1 bg--white border border--black rounded w--full">
      {% if data_unavailable %}
        <div class="flex flex--col flex--center-y flex--center-x py--4 text--center">
          <span class="label label--small text--gray-30">Chart Unavailable</span>
          <span class="description text--black mt--1">Insufficient historical data to render trends.</span>
        </div>
      {% else %}
        <svg class="block w--full h--auto" viewBox="0 0 400 180" preserveAspectRatio="xMidYMid meet">
          <!-- Grid lines (Y-axis) -->
          <g>
            {% for g in grid_lines %}
              <line x1="35" y1="{{ g.y }}" x2="375" y2="{{ g.y }}" stroke="#000" stroke-dasharray="2,2" stroke-width="1" />
              <text x="30" y="{{ g.y }}" font-size="11px" fill="#000" text-anchor="end" dominant-baseline="central">{{ g.label }}</text>
            {% endfor %}
          </g>

          <!-- X axis labels (Years) -->
          <g>
            {% for xl in x_labels %}
              <text x="{{ xl.x }}" y="174" font-size="11px" fill="#000" text-anchor="middle">{{ xl.label }}</text>
            {% endfor %}
          </g>

          <!-- SVG path representing Doomsday Clock trend line -->
          <g>
            <path d="{{ svg_path }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="miter" stroke-linecap="square" />

            <!-- Selected Year Highlight Dot -->
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="5" fill="#000" />
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="8" fill="none" stroke="#000" stroke-width="1.5" />
          </g>
        </svg>
      {% endif %}
    </div>
    <div class="flex flex--row flex--between flex--center-y text--gray-30 mt--1">
      <span class="label label--small">Peak Danger (Midnight)</span>
      <span class="label label--small">Safest (17 minutes)</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
  <span class="instance">Target: {{ selected_year }}</span>
</div>




<!-- Custom Field Reference for Linter: {{ selected_year }} -->



<div class="layout layout--col p--2">
  <div class="flex flex--col gap--xsmall">
    <div class="flex flex--col">
      <span class="label label--small text--gray-30">TARGET YEAR</span>
      <span class="title title--large text--black mt--xsmall">{{ selected_year }}</span>
    </div>
    
    <div class="flex flex--col mt--2 pt--2 border--h border--h-black">
      <span class="value value--small lg:value--base value--tnums mb--xsmall">{% if clock_face %}{{ clock_face }}{% else %}<span class="label label--small label--outline">--:--:--</span>{% endif %}</span>
      <span class="label label--small text--black">({% if display_time %}{{ display_time }}{% else %}<span class="label label--small label--outline">Unknown time</span>{% endif %} to midnight)</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
</div>


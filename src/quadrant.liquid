<!-- Custom Field Reference for Linter: {{ selected_year }} -->

<!-- Standard view (non-Model X) -->
<div class="layout layout--col p--2 lg:hidden">
  <div class="flex flex--col gap--xsmall">
    <div class="flex flex--col">
      <span class="label label--small text--gray-30 1bit:text--black">TARGET YEAR</span>
      <span class="title title--large text--black mt--xsmall">{{ selected_year }}</span>
    </div>
    
    <div class="flex flex--col mt--2 pt--2 border--h border--h-black">
      <span class="value value--small value--tnums mb--xsmall">{% if clock_face %}{{ clock_face }}{% else %}<span class="label label--small label--outline">--:--:--</span>{% endif %}</span>
      <span class="label label--small text--black">({% if display_time %}{{ display_time }}{% else %}<span class="label label--small label--outline">Unknown time</span>{% endif %} to midnight)</span>
    </div>
  </div>
</div>

<!-- Model X view (lg:) -->
<div class="layout layout--col p--3 hidden lg:flex">
  <div class="flex flex--col gap--xsmall h--full justify--between">
    <!-- Top Info Row -->
    <div class="flex--row flex--between flex--center-y mb--1">
      <div class="flex flex--col">
        <span class="label label--base text--gray-30 1bit:text--black">TARGET YEAR</span>
        <span class="title title--large text--black mt--xsmall">{{ selected_year }}</span>
      </div>
      <div class="flex flex--col text--right">
        <span class="value value--base value--tnums mb--xsmall">{% if clock_face %}{{ clock_face }}{% else %}<span class="label label--small lg:label--base label--outline">--:--:--</span>{% endif %}</span>
        <span class="label label--small text--black">({% if display_time %}{{ display_time }}{% else %}<span class="label label--small lg:label--base label--outline">Unknown time</span>{% endif %} to midnight)</span>
      </div>
    </div>
    
    <!-- Bottom: Danger Index Chart -->
    <div class="flex flex--col mt--1 pt--1 border--h border--h-black w--full">
      <span class="label label--small lg:label--base text--gray-30 1bit:text--black mb--1">DANGER INDEX OVER TIME</span>
      <div class="p--1 bg--white border border--black rounded w--full">
        {% if data_unavailable %}
          <div class="flex flex--col flex--center-y flex--center-x py--2 text--center">
            <span class="label label--small lg:label--base text--gray-30 1bit:text--black">Chart Unavailable</span>
          </div>
        {% else %}
          <svg class="block w--full h--auto" viewbox="0 0 400 180" preserveAspectRatio="xMidYMid meet">
            <!-- Grid lines (Y-axis) -->
            <g>
              {% for g in grid_lines %}
                <line x1="{{ grid_x1 | default: 35 }}" y1="{{ g.y }}" x2="{{ grid_x2 | default: 375 }}" y2="{{ g.y }}" stroke="#000" stroke-dasharray="2,2" stroke-width="1" />
                <text x="{{ grid_label_x | default: 30 }}" y="{{ g.y }}" class="text--xxsmall" fill="#000" text-anchor="end" dominant-baseline="central">{{ g.label }}</text>
              {% endfor %}
            </g>

            <!-- X axis labels (Years) -->
            <g>
              {% for xl in x_labels %}
                <text x="{{ xl.x }}" y="{{ x_label_y | default: 174 }}" class="text--xxsmall" fill="#000" text-anchor="middle">{{ xl.label }}</text>
              {% endfor %}
            </g>

            <!-- SVG path representing Doomsday Clock trend line -->
            <g>
              <path d="{{ svg_path }}" fill="none" stroke="#000" stroke-width="3" stroke-linejoin="miter" stroke-linecap="square" />

              <!-- Selected Year Highlight Dot -->
              <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="5" fill="#000" />
              <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="8" fill="none" stroke="#000" stroke-width="1.5" />
            </g>
          </svg>
        {% endif %}
      </div>
      <div class="flex flex--row flex--between flex--center-y text--gray-30 1bit:text--black mt--1">
        <span class="label label--small 1bit:text--black">Peak Danger</span>
        <span class="label label--small 1bit:text--black">Safest</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
</div>


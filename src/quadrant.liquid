<!-- Custom Field Reference for Linter: {{ selected_year }} -->



<div class="layout layout--col p--2">
  <div class="flex flex--col gap--xsmall">
    <div class="flex--row flex--between flex--center-y">
      <span class="label label--small text--gray-30">TARGET YEAR</span>
      <span class="label label--small text--black">{{ selected_year }}</span>
    </div>
    
    <div class="flex flex--col mt--1">
      <span class="value value--small value--tnums mb--1">{% if clock_face %}{{ clock_face }}{% else %}--:--:-- PM{% endif %}</span>
      <span class="label label--small text--black">({% if display_time %}{{ display_time }}{% else %}Unknown time{% endif %} to midnight)</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
</div>


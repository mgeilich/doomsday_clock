<!-- Custom Field Reference for Linter: {{ selected_year }} -->



<div class="layout layout--row portrait:layout--col p--2 gap--medium">
  <!-- Left Column: Selected Year, Clock & Reason -->
  <div class="col col--span-5 portrait:col--span-12 flex--col gap--space-between">
    <div class="flex flex--col gap--xsmall">
      <div class="flex--row flex--between flex--center-y mb--1">
        <span class="label label--small text--gray-40">TARGET YEAR: {{ selected_year }}</span>
        {% if selected_year != active_year %}
          <span class="label label--small text--gray-40">ACTIVE: {{ active_year }}</span>
        {% endif %}
      </div>
      <div class="flex flex--col mt--1">
        <span class="value value--small value--tnums mb--1">{{ clock_face }}</span>
      </div>
    </div>

    <div class="flex flex--col mt--2">
      <span class="label label--small text--gray-40">REASON & CONTEXT</span>
      <p class="description text--black">{{ reason }}</p>
    </div>
  </div>

  <!-- Right Column: Danger Index Chart -->
  <div class="col col--span-7 portrait:col--span-12 flex--col justify--between pl--4 border--v-1 border--v-black portrait:border--v-0 portrait:border--h-1 portrait:pt--2 portrait:pl--0">
    <span class="label label--small text--gray-40">DANGER INDEX OVER TIME (1947 - {{ latest_year }})</span>
    <div class="p--2 bg--white border--2 border--black rounded--small">
      <svg class="block" viewBox="0 0 380 200" width="100%" height="auto">
        <!-- Grid lines (Y-axis) representing seconds / minutes to midnight -->
        <g>
          {% for g in grid_lines %}
            <line x1="35" y1="{{ g.y }}" x2="355" y2="{{ g.y }}" stroke="#000000" stroke-dasharray="2,2" stroke-width="1" />
            <text x="30" y="{{ g.y }}" fill="#000000" font-size="12" font-family="sans-serif" text-anchor="end" dominant-baseline="central">{{ g.label }}</text>
          {% endfor %}
        </g>

        <!-- X axis labels (Years) -->
        <g>
          {% for xl in x_labels %}
            <text x="{{ xl.x }}" y="196" fill="#000000" font-size="12" font-family="sans-serif" text-anchor="middle">{{ xl.label }}</text>
          {% endfor %}
        </g>

        <!-- SVG path representing Doomsday Clock trend line -->
        <g>
          <path d="{{ svg_path }}" fill="none" stroke="#000000" stroke-width="3" stroke-linejoin="miter" stroke-linecap="square" />

          <!-- Selected Year Highlight Dot -->
          <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="5" fill="#000000" />
          <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="8" fill="none" stroke="#000000" stroke-width="1.5" />
        </g>
      </svg>
    </div>
    <!-- Small explanatory legend at the bottom of the graph -->
    <div class="flex flex--row flex--between flex--center-y text--gray-40">
      <span class="label label--small">Peak Danger</span>
      <span class="label label--small">Safest</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
  <span class="instance">Target: {{ selected_year }}</span>
</div>



<!-- Custom Field Reference for Linter: {{ selected_year }} -->

<style>
  .trmnl {
    --color-gray-10: var(--gray-10, #111111);
    --color-gray-20: var(--gray-20, #333333);
    --color-gray-30: var(--gray-30, #555555);
    --color-gray-40: var(--gray-40, #777777);
    --color-gray-50: var(--gray-50, #999999);
    --color-gray-60: var(--gray-60, #bbbbbb);
  }
  .chart-grid-line {
    stroke: var(--color-gray-60);
  }
  .chart-grid-text {
    fill: var(--color-gray-30);
    font-family: "NicoClean", sans-serif;
    font-size: 10px;
  }
</style>

<div class="layout layout--row portrait:layout--col p--2 gap--medium">
  <div class="columns portrait:layout--col">
    <!-- Left Column: Selected Year, Clock & Reason -->
    <div class="column flex--col justify--between">
      <div class="flex flex--col gap--xsmall">
        <div class="flex--row flex--between flex--center-y">
          <span class="label label--small text--gray-40">TARGET YEAR: {{ selected_year }}</span>
          {% if selected_year != active_year %}
            <span class="label label--small text--gray-40">ACTIVE: {{ active_year }}</span>
          {% endif %}
        </div>
        <div class="flex flex--col mt--1">
          <span class="value value--small value--tnums mb--1">{{ clock_face }}</span>
        </div>
      </div>

      <div class="flex flex--col mt--2">
        <span class="label label--small text--gray-40">REASON & CONTEXT</span>
        <p class="description text--black">{{ reason }}</p>
      </div>
    </div>

    <!-- Right Column: Danger Index Chart -->
    <div class="column flex--col justify--between pl--4 border--v-1 border--v-black portrait:border--v-0 portrait:border--h-1 portrait:pt--2 portrait:pl--0">
      <span class="label label--small text--gray-40">DANGER INDEX OVER TIME (1947 - {{ latest_year }})</span>
      <div class="p--2 bg--white border--2 border--black rounded--small">
        <svg class="block" viewBox="0 0 380 200" width="100%" height="auto">
          <!-- Grid lines (Y-axis) representing seconds / minutes to midnight -->
          <g>
            {% for g in grid_lines %}
              <line class="chart-grid-line" x1="35" y1="{{ g.y }}" x2="355" y2="{{ g.y }}" stroke-dasharray="2,2" stroke-width="1" />
              <text class="chart-grid-text" x="30" y="{{ g.y }}" text-anchor="end" dominant-baseline="central">{{ g.label }}</text>
            {% endfor %}
          </g>

          <!-- X axis labels (Years) -->
          <g>
            {% for xl in x_labels %}
              <text class="chart-grid-text" x="{{ xl.x }}" y="196" text-anchor="middle">{{ xl.label }}</text>
            {% endfor %}
          </g>

          <!-- SVG path representing Doomsday Clock trend line -->
          <g class="text--black">
            <path d="{{ svg_path }}" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="miter" stroke-linecap="square" />

            <!-- Selected Year Highlight Dot -->
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="5" fill="currentColor" />
            <circle cx="{{ dot_x }}" cy="{{ dot_y }}" r="8" fill="none" stroke="currentColor" stroke-width="1.5" />
          </g>
        </svg>
      </div>
      <!-- Small explanatory legend at the bottom of the graph -->
      <div class="flex flex--row flex--between flex--center-y text--gray-40">
        <span class="label label--small">Peak Danger</span>
        <span class="label label--small">Safest</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Doomsday Clock</span>
  <span class="instance">Target: {{ selected_year }}</span>
</div>


